<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_elmogps_contract" model="ir.sequence">
        <field name="name">ELMOGPS Contract</field>
        <field name="code">elmogps.contract</field>
        <field name="prefix">ELM-CNT-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_elmogps_installation" model="ir.sequence">
        <field name="name">ELMOGPS Installation</field>
        <field name="code">elmogps.installation</field>
        <field name="prefix">ELM-INS-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_elmogps_vehicle" model="ir.sequence">
        <field name="name">ELMOGPS Vehicle Reference</field>
        <field name="code">elmogps.vehicle.reference</field>
        <field name="prefix">ELM-VEH-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
