<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_elmogps_vehicle_tree" model="ir.ui.view">
        <field name="name">elmogps.vehicle.reference.tree</field>
        <field name="model">elmogps.vehicle.reference</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="plate_number"/>
                <field name="partner_id"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="vehicle_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_elmogps_vehicle_form" model="ir.ui.view">
        <field name="name">elmogps.vehicle.reference.form</field>
        <field name="model">elmogps.vehicle.reference</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_installations" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="installation_count" widget="statinfo" string="Installations"/>
                        </button>
                        <button name="action_view_maintenance" type="object" class="oe_stat_button" icon="fa-medkit">
                            <field name="maintenance_count" widget="statinfo" string="Maintenance"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="plate_number"/>
                            <field name="vin"/>
                            <field name="elmogps_vehicle_id"/>
                        </group>
                        <group>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="model_year"/>
                            <field name="vehicle_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_elmogps_vehicle_search" model="ir.ui.view">
        <field name="name">elmogps.vehicle.reference.search</field>
        <field name="model">elmogps.vehicle.reference</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plate_number"/>
                <field name="partner_id"/>
                <field name="vin"/>
            </search>
        </field>
    </record>

    <record id="action_elmogps_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">elmogps.vehicle.reference</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
