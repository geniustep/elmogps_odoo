<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard action using window actions with domains -->
    <record id="action_elmogps_dashboard_customers" model="ir.actions.act_window">
        <field name="name">Active Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_elmogps_customer', '=', True), ('elmogps_service_status', '=', 'active')]</field>
    </record>

    <record id="action_elmogps_dashboard_contracts" model="ir.actions.act_window">
        <field name="name">Active Contracts</field>
        <field name="res_model">elmogps.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'active')]</field>
    </record>

    <record id="action_elmogps_dashboard_gps_stock" model="ir.actions.act_window">
        <field name="name">GPS In Stock</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('elmogps_asset_type', '=', 'gps_device'), ('elmogps_operational_status', '=', 'in_stock')]</field>
    </record>

    <record id="action_elmogps_dashboard_gps_installed" model="ir.actions.act_window">
        <field name="name">GPS Installed</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('elmogps_asset_type', '=', 'gps_device'), ('elmogps_operational_status', '=', 'installed')]</field>
    </record>

    <record id="action_elmogps_dashboard_sim_active" model="ir.actions.act_window">
        <field name="name">Active SIM Cards</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('elmogps_asset_type', '=', 'sim_card'), ('elmogps_operational_status', 'in', ('allocated', 'installed'))]</field>
    </record>

    <record id="action_elmogps_dashboard_scheduled" model="ir.actions.act_window">
        <field name="name">Scheduled Installations</field>
        <field name="res_model">elmogps.installation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'scheduled')]</field>
    </record>

    <record id="action_elmogps_dashboard_failed_events" model="ir.actions.act_window">
        <field name="name">Failed Integration Events</field>
        <field name="res_model">elmogps.integration.event</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', 'in', ('failed', 'dead'))]</field>
    </record>

    <record id="action_elmogps_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_elmogps_customer', '=', True)]</field>
        <field name="context">{'search_default_elmogps_customers': 1}</field>
    </record>

    <record id="action_elmogps_gps_devices" model="ir.actions.act_window">
        <field name="name">GPS Devices</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('elmogps_asset_type', '=', 'gps_device')]</field>
        <field name="context">{'search_default_gps_devices': 1}</field>
    </record>

    <record id="action_elmogps_sim_cards" model="ir.actions.act_window">
        <field name="name">SIM Cards</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('elmogps_asset_type', '=', 'sim_card')]</field>
        <field name="context">{'search_default_sim_cards': 1}</field>
    </record>

    <record id="action_elmogps_configuration" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'elmogps_odoo'}</field>
    </record>

    <menuitem id="menu_elmogps_root" name="ELMOGPS" sequence="25"
              web_icon="elmogps_odoo,static/description/icon.png"
              groups="elmogps_odoo.group_elmogps_user"/>

    <menuitem id="menu_elmogps_dashboard" name="Dashboard" parent="menu_elmogps_root" sequence="1"/>
    <menuitem id="menu_elmogps_dashboard_customers" name="Active Customers" parent="menu_elmogps_dashboard"
              action="action_elmogps_dashboard_customers" sequence="1"/>
    <menuitem id="menu_elmogps_dashboard_contracts" name="Active Contracts" parent="menu_elmogps_dashboard"
              action="action_elmogps_dashboard_contracts" sequence="2"/>
    <menuitem id="menu_elmogps_dashboard_gps_stock" name="GPS In Stock" parent="menu_elmogps_dashboard"
              action="action_elmogps_dashboard_gps_stock" sequence="3"/>
    <menuitem id="menu_elmogps_dashboard_gps_installed" name="GPS Installed" parent="menu_elmogps_dashboard"
              action="action_elmogps_dashboard_gps_installed" sequence="4"/>
    <menuitem id="menu_elmogps_dashboard_scheduled" name="Scheduled Installations" parent="menu_elmogps_dashboard"
              action="action_elmogps_dashboard_scheduled" sequence="5"/>
    <menuitem id="menu_elmogps_dashboard_failed" name="Failed Events" parent="menu_elmogps_dashboard"
              action="action_elmogps_dashboard_failed_events" sequence="6"
              groups="elmogps_odoo.group_elmogps_integration_admin"/>

    <menuitem id="menu_elmogps_customers" name="Customers" parent="menu_elmogps_root"
              action="action_elmogps_customers" sequence="10" groups="elmogps_odoo.group_elmogps_sales"/>
    <menuitem id="menu_elmogps_contracts" name="Contracts" parent="menu_elmogps_root"
              action="action_elmogps_contract" sequence="20" groups="elmogps_odoo.group_elmogps_sales"/>
    <menuitem id="menu_elmogps_vehicles" name="Vehicles" parent="menu_elmogps_root"
              action="action_elmogps_vehicle" sequence="30"/>
    <menuitem id="menu_elmogps_installations" name="Installations" parent="menu_elmogps_root"
              action="action_elmogps_installation" sequence="40"/>
    <menuitem id="menu_elmogps_gps_devices" name="GPS Devices" parent="menu_elmogps_root"
              action="action_elmogps_gps_devices" sequence="50" groups="elmogps_odoo.group_elmogps_inventory"/>
    <menuitem id="menu_elmogps_sim_cards" name="SIM Cards" parent="menu_elmogps_root"
              action="action_elmogps_sim_cards" sequence="60" groups="elmogps_odoo.group_elmogps_inventory"/>
    <menuitem id="menu_elmogps_maintenance" name="Maintenance" parent="menu_elmogps_root"
              action="action_elmogps_maintenance" sequence="70"/>
    <menuitem id="menu_elmogps_integration" name="Integration" parent="menu_elmogps_root" sequence="80"
              groups="elmogps_odoo.group_elmogps_integration_admin"/>
    <menuitem id="menu_elmogps_integration_events" name="Outbox Events" parent="menu_elmogps_integration"
              action="action_elmogps_integration_events" sequence="1"/>
    <menuitem id="menu_elmogps_integration_logs" name="Logs" parent="menu_elmogps_integration"
              action="action_elmogps_integration_logs" sequence="2"/>
    <menuitem id="menu_elmogps_configuration" name="Configuration" parent="menu_elmogps_root"
              action="action_elmogps_configuration" sequence="90"
              groups="elmogps_odoo.group_elmogps_integration_admin"/>
</odoo>
