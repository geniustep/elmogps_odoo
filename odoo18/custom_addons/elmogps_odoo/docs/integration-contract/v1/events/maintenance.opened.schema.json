{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmogps.local/integration-contract/v1/events/maintenance.opened.schema.json",
  "title": "ELMOGPS Event Payload \u2014 maintenance.opened",
  "type": "object",
  "additionalProperties": true,
