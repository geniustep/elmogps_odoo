{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmogps.local/integration-contract/v1/events/device.released.schema.json",
  "title": "ELMOGPS Event Payload \u2014 device.released",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "odoo_stock_lot_id",
    "imei",
    "released_at",
    "reason_code"
  ],
  "properties": {
    "odoo_stock_lot_id": {
      "type": "integer"
    },
    "elmogps_device_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "imei": {
      "type": "string"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason_code": {
      "type": "string"
    }
  }
}