<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_elmogps" model="ir.module.category">
        <field name="name">ELMOGPS</field>
        <field name="description">ELMOGPS fleet tracking management</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_elmogps_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_elmogps"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_elmogps_sales" model="res.groups">
        <field name="name">Sales</field>
        <field name="category_id" ref="module_category_elmogps"/>
        <field name="implied_ids" eval="[(4, ref('group_elmogps_user'))]"/>
    </record>

    <record id="group_elmogps_inventory" model="res.groups">
        <field name="name">Inventory</field>
        <field name="category_id" ref="module_category_elmogps"/>
        <field name="implied_ids" eval="[(4, ref('group_elmogps_user'))]"/>
    </record>

    <record id="group_elmogps_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="category_id" ref="module_category_elmogps"/>
        <field name="implied_ids" eval="[(4, ref('group_elmogps_user'))]"/>
    </record>

    <record id="group_elmogps_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_elmogps"/>
        <field name="implied_ids" eval="[
            (4, ref('group_elmogps_sales')),
            (4, ref('group_elmogps_inventory')),
        ]"/>
    </record>

    <record id="group_elmogps_integration_admin" model="res.groups">
        <field name="name">Integration Admin</field>
        <field name="category_id" ref="module_category_elmogps"/>
        <field name="implied_ids" eval="[(4, ref('group_elmogps_manager'))]"/>
    </record>

    <!-- Multi-company record rules -->
    <record id="elmogps_contract_company_rule" model="ir.rule">
        <field name="name">ELMOGPS Contract: multi-company</field>
        <field name="model_id" ref="model_elmogps_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_elmogps_user'))]"/>
    </record>

    <record id="elmogps_vehicle_company_rule" model="ir.rule">
        <field name="name">ELMOGPS Vehicle: multi-company</field>
        <field name="model_id" ref="model_elmogps_vehicle_reference"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_elmogps_user'))]"/>
    </record>

    <record id="elmogps_installation_company_rule" model="ir.rule">
        <field name="name">ELMOGPS Installation: multi-company</field>
        <field name="model_id" ref="model_elmogps_installation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_elmogps_user'))]"/>
    </record>

    <record id="elmogps_installation_technician_rule" model="ir.rule">
        <field name="name">ELMOGPS Installation: technician scope</field>
        <field name="model_id" ref="model_elmogps_installation"/>
        <field name="domain_force">[('technician_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_elmogps_technician'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="elmogps_event_company_rule" model="ir.rule">
        <field name="name">ELMOGPS Integration Event: multi-company</field>
        <field name="model_id" ref="model_elmogps_integration_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_elmogps_integration_admin'))]"/>
    </record>

    <record id="elmogps_log_company_rule" model="ir.rule">
        <field name="name">ELMOGPS Integration Log: multi-company</field>
        <field name="model_id" ref="model_elmogps_integration_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_elmogps_integration_admin'))]"/>
    </record>
</odoo>
